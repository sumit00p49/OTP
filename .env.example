# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# LZT Market API Key
LZT_API_KEY=YOUR_LZT_API_KEY_HERE
LZT_BASE_URL=https://api.lzt.market

# Admin Configuration
# Comma-separated Telegram user IDs who can approve deposits
ADMIN_IDS=123456789,987654321
# Group/Channel ID where deposit screenshots are forwarded
ADMIN_GROUP_ID=-1001234567890

# UPI Payment Details
UPI_ID=KaizenSeller@ybl
UPI_NAME=Kaizen Seller

# Pricing (INR)
CHEAP_ACC_PRICE=30.0
GOOD_ACC_PRICE=60.0

# Minimum deposit amount (INR)
MIN_DEPOSIT=10.0

# Database path
DB_PATH=bot_database.db

# LZT Category
LZT_CATEGORY=telegram
