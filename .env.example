# ==================== Telegram Bot ====================
# Get from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ==================== LZT Market API ====================
# Get your token from: https://lzt.market/account/api
LZT_API_KEY=YOUR_LZT_API_KEY_HERE
# Production API base URL
LZT_BASE_URL=https://prod-api.lzt.market

# ==================== Product Pricing ====================
# JSON array of countries/products. Each country has its own price & LZT filters.
# Format: [{"code":"XX","name":"Name","flag":"🏳️","price":70,"max_lzt":0.15,"filters":{...}}]
#
# AVAILABLE FILTERS (from LZT API):
#   "origin[]"          : "resale" / "autoreg" / "personal" / "stealer"
#   "nsb"               : 1 (no spam block only)
#   "sb"                : 1 (spam block only)
#   "telegram_password" : 0 (no password) / 1 (has password)
#   "pmin"              : min price USD
#   "not_sold_before"   : 1 (never sold)
#
# EXAMPLE: India (Resale, no password) + USA (Autoreg):
# PRODUCTS=[{"code":"IN","name":"India","flag":"🇮🇳","price":70,"max_lzt":0.15,"filters":{"origin[]":"resale","telegram_password":0}},{"code":"US","name":"USA","flag":"🇺🇸","price":150,"max_lzt":0.50,"filters":{"origin[]":"autoreg","nsb":1}}]

PRODUCTS=[{"code":"IN","name":"India","flag":"🇮🇳","price":70,"max_lzt":0.15,"filters":{"origin[]":"resale","telegram_password":0}}]

# Legacy (used as fallback if PRODUCTS not set)
ACCOUNT_PRICE_INR=70.0
MAX_LZT_PRICE_USD=0.15
ACCOUNT_COUNTRY=IN

# ==================== Admin Configuration ====================
# Your Telegram user ID (comma-separated for multiple admins)
ADMIN_IDS=123456789
# Group/Channel ID where deposit screenshots go for approval
ADMIN_GROUP_ID=-1001234567890

# ==================== UPI Payment Details ====================
UPI_ID=SurojSeller@fam
UPI_NAME=SANDIP BERA
# Optional: custom QR code image URL (leave empty for auto-generated QR)
UPI_QR_URL=

# ==================== Deposit ====================
MIN_DEPOSIT=10.0

# ==================== Database ====================
DB_PATH=bot_database.db

# ==================== MongoDB (for persistent products) ====================
# Products/countries are stored in MongoDB so they don't get lost on restart/redeploy.
# If not set, falls back to local products.json file.
# Get free cluster: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ==================== Auto Payment Verification (Gmail) ====================
# Bot reads your Gmail (where FamApp/UPI payment emails land) and auto-approves
# deposits by matching the exact received amount. Leave blank to disable
# (falls back to manual admin approval via screenshot).
#
# SETUP:
#   1. Enable 2-Step Verification on your Google account
#   2. Create App Password: myaccount.google.com/apppasswords
#   3. Paste your Gmail and the 16-char app password below
GMAIL_ADDRESS=youremail@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Sender of payment notification emails (FamApp/FamX). Change if different.
PAYMENT_EMAIL_SENDER=no-reply@famapp.in
# Poll interval (seconds) and match window (minutes)
PAYMENT_POLL_INTERVAL=30
PAYMENT_MATCH_WINDOW_MIN=30



# ==================== Channel Force Join ====================
# Channel username (without @) users must join. Leave empty to disable.
FORCE_JOIN_CHANNEL=

# ==================== Log Channel ====================
# Channel/Group ID where bot posts "NEW ACCOUNT SOLD" on every purchase.
# Bot must be admin in this channel. Get ID from @userinfobot
LOG_CHANNEL_ID=

# ==================== Daily Report ====================
# Hour (24h) when daily report is sent to admins
DAILY_REPORT_HOUR=23

# ==================== Bulk Discount ====================
# 5+ accounts = ₹10 off, 10+ accounts = ₹20 off
BULK_DISCOUNT_5=10.0
BULK_DISCOUNT_10=20.0
