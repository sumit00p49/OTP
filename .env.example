# ==================== Telegram Bot ====================
# Get from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ==================== LZT Market API ====================
# Get your token from: https://lzt.market/account/api
LZT_API_KEY=YOUR_LZT_API_KEY_HERE
# Production API base URL
LZT_BASE_URL=https://prod-api.lzt.market

# ==================== Product Pricing ====================
# JSON array of countries/products. Each country has its own price & LZT filters.
# Format: [{"code":"XX","name":"Name","flag":"🏳️","price":70,"max_lzt":0.15,"filters":{...}}]
#
# AVAILABLE FILTERS (from LZT API):
#   "origin[]"          : "resale" / "autoreg" / "personal" / "stealer"
#   "nsb"               : 1 (no spam block only)
#   "sb"                : 1 (spam block only)
#   "telegram_password" : 0 (no password) / 1 (has password)
#   "pmin"              : min price USD
#   "not_sold_before"   : 1 (never sold)
#
# EXAMPLE: India (Resale, no password) + USA (Autoreg):
# PRODUCTS=[{"code":"IN","name":"India","flag":"🇮🇳","price":70,"max_lzt":0.15,"filters":{"origin[]":"resale","telegram_password":0}},{"code":"US","name":"USA","flag":"🇺🇸","price":150,"max_lzt":0.50,"filters":{"origin[]":"autoreg","nsb":1}}]

PRODUCTS=[{"code":"IN","name":"India","flag":"🇮🇳","price":70,"max_lzt":0.15,"filters":{"origin[]":"resale","telegram_password":0}}]

# Legacy (used as fallback if PRODUCTS not set)
ACCOUNT_PRICE_INR=70.0
MAX_LZT_PRICE_USD=0.15
ACCOUNT_COUNTRY=IN

# ==================== Admin Configuration ====================
# Your Telegram user ID (comma-separated for multiple admins)
ADMIN_IDS=123456789
# Group/Channel ID where deposit screenshots go for approval
ADMIN_GROUP_ID=-1001234567890

# ==================== UPI Payment Details ====================
UPI_ID=SurojSeller@fam
UPI_NAME=SANDIP BERA
# Optional: custom QR code image URL (leave empty for auto-generated QR)
UPI_QR_URL=

# ==================== Deposit ====================
MIN_DEPOSIT=10.0

# ==================== Database ====================
DB_PATH=bot_database.db
