# ==================== Telegram Bot ====================
# Get from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ==================== LZT Market API ====================
# Get your token from: https://lzt.market/account/api
LZT_API_KEY=YOUR_LZT_API_KEY_HERE
# Production base URL (do not change unless LZT moves it)
LZT_BASE_URL=https://prod-api.lzt.market
# Category slug for Telegram accounts
LZT_CATEGORY=telegram
# Buy method: "fastbuy" (atomic, 1 call) or "reserve" (reserve -> confirm)
BUY_METHOD=fastbuy

# ==================== Admin Configuration ====================
# Comma-separated Telegram user IDs allowed to approve deposits
ADMIN_IDS=123456789,987654321
# Group/Channel ID where deposit screenshots are forwarded
ADMIN_GROUP_ID=-1001234567890

# ==================== UPI Payment Details ====================
UPI_ID=KaizenSeller@ybl
UPI_NAME=Kaizen Seller

# ==================== Currency Conversion ====================
# LZT charges in RUB/USD/EUR; wallet is INR. 1 unit = X INR.
USD_TO_INR=85.0
RUB_TO_INR=1.10
EUR_TO_INR=92.0
# Flat profit markup in INR: user pays (real price + this amount).
MARKUP_FLAT_INR=55.0
# Optional extra percentage markup (0 = flat markup only)
MARKUP_PERCENT=0.0

# ==================== Pricing ====================
# "dynamic" = real LZT price + markup | "fixed" = flat INR price
PRICE_MODE=dynamic
# Used only when PRICE_MODE=fixed
CHEAP_ACC_PRICE=30.0
GOOD_ACC_PRICE=60.0
# Safety cap: never auto-buy an account above this INR price
MAX_ACC_PRICE_INR=500.0

# ==================== Deposit ====================
MIN_DEPOSIT=10.0

# ==================== Database ====================
DB_PATH=bot_database.db
