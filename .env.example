# ==================== Telegram Bot ====================
# Get from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ==================== LZT Market API ====================
# Get your token from: https://lzt.market/account/api
LZT_API_KEY=YOUR_LZT_API_KEY_HERE
# Production API base URL
LZT_BASE_URL=https://prod-api.lzt.market

# ==================== Product Pricing ====================
# Fixed price in INR that users pay per account
ACCOUNT_PRICE_INR=60.0
# Max USD price to pay on LZT (safety: won't buy if price > this)
MAX_LZT_PRICE_USD=0.15
# Country filter (IN = India)
ACCOUNT_COUNTRY=IN

# ==================== Admin Configuration ====================
# Your Telegram user ID (comma-separated for multiple admins)
ADMIN_IDS=123456789
# Group/Channel ID where deposit screenshots go for approval
ADMIN_GROUP_ID=-1001234567890

# ==================== UPI Payment Details ====================
UPI_ID=KaizenSeller@ybl
UPI_NAME=Kaizen Seller
# Optional: custom QR code image URL (leave empty for auto-generated QR)
UPI_QR_URL=

# ==================== Deposit ====================
MIN_DEPOSIT=10.0

# ==================== Database ====================
DB_PATH=bot_database.db
